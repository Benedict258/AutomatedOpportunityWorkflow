# Application
NODE_ENV=development
APP_NAME=AutomatedOpportunityWorkflow
PORT=3001
FRONTEND_URL=http://localhost:5173

# Backend API
API_URL=http://localhost:3001

# Database - PostgreSQL for future phases
DATABASE_URL=postgresql://${POSTGRES_USER:-opp_user}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB:-opportunity_intelligence}
POSTGRES_USER=opp_user
POSTGRES_PASSWORD=
POSTGRES_DB=opportunity_intelligence

# Shared
LOG_LEVEL=info

# LLM Model Slots - secrets/infrastructure, do NOT put in YAML config
EXTRACTION_MODEL=
CLASSIFICATION_MODEL=
MATCHING_MODEL=
REASONING_MODEL=
EMBEDDING_MODEL=
RERANKING_MODEL=

# Optional services - not configured in Step 1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# OPENAI_API_KEY=

