# Automated Opportunity Workflow - Environment Configuration
# =============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!
#
# Variable Categories:
#   [REQ]  = Required for all environments
#   [OPT]  = Optional (has sensible default)
#   [SEC]  = SECRET - Never commit, use secret manager in production
#   [DEV]  = Development only (override in production)
#   [PROD] = Production only (set in production deployment)
#
# For full documentation, see: docs/phase6/environment.md

# -----------------------------------------------------------------------------
# APPLICATION & INFRASTRUCTURE [REQ]
# -----------------------------------------------------------------------------
NODE_ENV=development                    # [REQ] Runtime: development | production | test
APP_NAME=AutomatedOpportunityWorkflow   # [REQ] Application identifier
PORT=3001                               # [REQ] HTTP server port (8080 in production)
FRONTEND_URL=http://localhost:5173      # [REQ] CORS origin for frontend
API_URL=http://localhost:3001           # [REQ] Backend API base URL

# -----------------------------------------------------------------------------
# DATABASE [REQ] [SEC: POSTGRES_PASSWORD]
# -----------------------------------------------------------------------------
# Full connection string (supports ${POSTGRES_USER}, ${POSTGRES_PASSWORD}, ${POSTGRES_DB} substitution)
DATABASE_URL=postgresql://${POSTGRES_USER:-opp_user}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB:-opportunity_intelligence}

# Individual components (used to compose DATABASE_URL above)
POSTGRES_USER=opp_user                  # [REQ] Database username
POSTGRES_PASSWORD=                      # [REQ] [SEC] Database password - SET IN .env, NEVER COMMIT
POSTGRES_DB=opportunity_intelligence    # [REQ] Database name

# -----------------------------------------------------------------------------
# OBSERVABILITY [OPT]
# -----------------------------------------------------------------------------
LOG_LEVEL=info                          # [OPT] debug | info | warn | error (default: info)

# -----------------------------------------------------------------------------
# LLM MODEL SLOTS (Legacy / Simple) [OPT] [SEC]
# -----------------------------------------------------------------------------
# Set these to specific model IDs if using simple configuration.
# For advanced multi-provider setup, use MODEL_PROVIDER_* and MODEL_* variables below.
EXTRACTION_MODEL=                       # Model ID for requirement extraction
CLASSIFICATION_MODEL=                   # Model ID for taxonomy classification
MATCHING_MODEL=                         # Model ID for semantic matching
REASONING_MODEL=                        # Model ID for reasoning/timing intelligence
EMBEDDING_MODEL=                        # Model ID for embeddings
RERANKING_MODEL=                        # Model ID for reranking (optional)

# -----------------------------------------------------------------------------
# LLM PROVIDER CONFIGURATION (Recommended for Production)
# -----------------------------------------------------------------------------
# Define providers: MODEL_PROVIDER_<PROVIDER_ID>_<SETTING>
# Example for NVIDIA (uncomment and fill):
# MODEL_PROVIDER_NVIDIA_TYPE=openai-compatible
# MODEL_PROVIDER_NVIDIA_NAME=NVIDIA
# MODEL_PROVIDER_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# MODEL_PROVIDER_NVIDIA_API_KEY=nvapi-...                    # [SEC] Your NVIDIA API key
# MODEL_PROVIDER_NVIDIA_ENABLED=true
# MODEL_PROVIDER_NVIDIA_PRIORITY=1
# MODEL_PROVIDER_NVIDIA_RATE_LIMIT_RPM=60
# MODEL_PROVIDER_NVIDIA_RATE_LIMIT_TPM=150000

# Example for OpenAI (uncomment and fill):
# MODEL_PROVIDER_OPENAI_TYPE=openai-compatible
# MODEL_PROVIDER_OPENAI_NAME=OpenAI
# MODEL_PROVIDER_OPENAI_BASE_URL=https://api.openai.com/v1
# MODEL_PROVIDER_OPENAI_API_KEY=sk-...                       # [SEC] Your OpenAI API key
# MODEL_PROVIDER_OPENAI_ENABLED=true
# MODEL_PROVIDER_OPENAI_PRIORITY=2
# MODEL_PROVIDER_OPENAI_RATE_LIMIT_RPM=60
# MODEL_PROVIDER_OPENAI_RATE_LIMIT_TPM=150000

# Example for Ollama Local (no API key needed):
# MODEL_PROVIDER_OLLAMA_TYPE=ollama
# MODEL_PROVIDER_OLLAMA_NAME=Ollama Local
# MODEL_PROVIDER_OLLAMA_BASE_URL=http://localhost:11434
# MODEL_PROVIDER_OLLAMA_ENABLED=true
# MODEL_PROVIDER_OLLAMA_PRIORITY=3

# -----------------------------------------------------------------------------
# LLM MODEL DEFINITIONS
# -----------------------------------------------------------------------------
# Define models: MODEL_<MODEL_ID>_<SETTING>
# MODEL_ID: lowercase, hyphens allowed (e.g., nemotron-3-ultra, gpt-4o-mini)
# Capabilities: text-generation, structured-generation, embeddings

# NVIDIA Nemotron 3 Ultra (Primary reasoning model)
# MODEL_NEMOTRON_3_ULTRA_PROVIDER=nvidia
# MODEL_NEMOTRON_3_ULTRA_NAME=nvidia/nemotron-3-ultra-550b-a55b
# MODEL_NEMOTRON_3_ULTRA_CAPABILITIES=text-generation,structured-generation
# MODEL_NEMOTRON_3_ULTRA_CONTEXT=128000
# MODEL_NEMOTRON_3_ULTRA_TEMPERATURE=0.1
# MODEL_NEMOTRON_3_ULTRA_MAX_TOKENS=4096
# MODEL_NEMOTRON_3_ULTRA_ENABLED=true

# NVIDIA Embedding QA Model
# MODEL_NVIDIA_EMBED_QA_4_PROVIDER=nvidia
# MODEL_NVIDIA_EMBED_QA_4_NAME=nvidia/nv-embedqa-mistral-7b-v2
# MODEL_NVIDIA_EMBED_QA_4_CAPABILITIES=embeddings
# MODEL_NVIDIA_EMBED_QA_4_DIMENSIONS=1024
# MODEL_NVIDIA_EMBED_QA_4_ENABLED=true

# OpenAI GPT-4o Mini
# MODEL_GPT4O_MINI_PROVIDER=openai
# MODEL_GPT4O_MINI_NAME=gpt-4o-mini
# MODEL_GPT4O_MINI_CAPABILITIES=text-generation,structured-generation
# MODEL_GPT4O_MINI_CONTEXT=128000
# MODEL_GPT4O_MINI_TEMPERATURE=0.1
# MODEL_GPT4O_MINI_MAX_TOKENS=4096
# MODEL_GPT4O_MINI_ENABLED=true

# OpenAI text-embedding-3-small
# MODEL_TEXT_EMBEDDING_3_SMALL_PROVIDER=openai
# MODEL_TEXT_EMBEDDING_3_SMALL_NAME=text-embedding-3-small
# MODEL_TEXT_EMBEDDING_3_SMALL_CAPABILITIES=embeddings
# MODEL_TEXT_EMBEDDING_3_SMALL_DIMENSIONS=1536
# MODEL_TEXT_EMBEDDING_3_SMALL_ENABLED=true

# Ollama Local Models (example)
# MODEL_LLAMA3_1_8B_PROVIDER=ollama
# MODEL_LLAMA3_1_8B_NAME=llama3.1:8b
# MODEL_LLAMA3_1_8B_CAPABILITIES=text-generation,structured-generation
# MODEL_LLAMA3_1_8B_CONTEXT=131072
# MODEL_LLAMA3_1_8B_TEMPERATURE=0.1
# MODEL_LLAMA3_1_8B_MAX_TOKENS=4096
# MODEL_LLAMA3_1_8B_ENABLED=true

# -----------------------------------------------------------------------------
# DEFAULT MODEL ASSIGNMENTS
# -----------------------------------------------------------------------------
# Used when no explicit model is specified for a task.
# Values must match MODEL_<ID> definitions above.
MODEL_DEFAULT_EXTRACTION=nemotron-3-ultra
MODEL_DEFAULT_CLASSIFICATION=nemotron-3-ultra
MODEL_DEFAULT_EMBEDDING=text-embedding-3-small
MODEL_DEFAULT_REASONING=nemotron-3-ultra
MODEL_DEFAULT_MATCHING=text-embedding-3-small
MODEL_DEFAULT_RERANKING=

# -----------------------------------------------------------------------------
# OPTIONAL CLOUD SERVICES [OPT] [SEC]
# -----------------------------------------------------------------------------
# AWS (for S3, Secrets Manager, etc.)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# -----------------------------------------------------------------------------
# BUSINESS CONFIG OVERRIDES (CONFIG_*)
# -----------------------------------------------------------------------------
# Any setting from shared/config/default.yaml can be overridden at runtime.
# Format: CONFIG_<SECTION>_<SUBSECTION>_<KEY>=value
# Examples (uncomment to use):
# CONFIG_MATCHING_THRESHOLDS_MIN_SCORE=0.7
# CONFIG_FEATURE_FLAGS_NOTIFICATION_ENABLED=false
# CONFIG_SOURCES_MAX_ITEMS_PER_SOURCE=50
# CONFIG_NOTIFICATIONS_SCHEDULE_TIMEZONE=America/New_York