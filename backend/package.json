{
  "name": "backend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node -r dotenv/config dist/backend/src/index.js",
    "migrate": "tsx src/db/migrations.ts",
    "db:check": "tsx src/db/check-connection.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --reporter=verbose --test-timeout=10000 tests/unit",
    "test:integration": "vitest run --reporter=verbose --test-timeout=30000 tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "npm run build && node dist/scripts/run-usajobs-pipeline.js"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.0",
    "@fastify/helmet": "^11.0.0",
    "@fastify/rate-limit": "^9.0.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^4.0.0",
    "fastify": "^4.26.0",
    "jose": "^5.2.0",
    "jsonwebtoken": "^9.0.0",
    "pg": "^8.11.0",
    "pino": "^8.19.0",
    "pino-pretty": "^11.0.0",
    "shared": "file:../shared",
    "zod": "^3.22.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.10.0",
    "@vitest/coverage-v8": "^1.6.0",
    "dotenv": "^16.3.1",
    "tsc-alias": "^1.9.5",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.6.0"
  }
}

