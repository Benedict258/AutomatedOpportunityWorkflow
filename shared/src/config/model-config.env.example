# Model Configuration
# Copy to .env.local and fill in your API keys

# Model Provider Configuration
# Provider types: openai-compatible, ollama

# Example OpenAI Provider
# MODEL_PROVIDER_OPENAI_ID=openai
# MODEL_PROVIDER_OPENAI_NAME=OpenAI
# MODEL_PROVIDER_OPENAI_TYPE=openai-compatible
# MODEL_PROVIDER_OPENAI_BASE_URL=https://api.openai.com/v1
# MODEL_PROVIDER_OPENAI_API_KEY=sk-...
# MODEL_PROVIDER_OPENAI_ENABLED=true
# MODEL_PROVIDER_OPENAI_PRIORITY=1
# MODEL_PROVIDER_OPENAI_RATE_LIMIT_RPM=60
# MODEL_PROVIDER_OPENAI_RATE_LIMIT_TPM=150000

# Example Ollama Provider (local)
# MODEL_PROVIDER_OLLAMA_ID=ollama
# MODEL_PROVIDER_OLLAMA_NAME=Ollama Local
# MODEL_PROVIDER_OLLAMA_TYPE=ollama
# MODEL_PROVIDER_OLLAMA_BASE_URL=http://localhost:11434
# MODEL_PROVIDER_OLLAMA_ENABLED=true
# MODEL_PROVIDER_OLLAMA_PRIORITY=2

# Model Definitions
# Format: MODEL_<MODEL_ID>_PROVIDER=<provider_id>
# MODEL_<MODEL_ID>_NAME=<model_name>
# MODEL_<MODEL_ID>_CAPABILITIES=text-generation,structured-generation,embeddings
# MODEL_<MODEL_ID>_ENABLED=true
# MODEL_<MODEL_ID>_FALLBACK=<fallback_model_id>

# Example Models
# MODEL_GPT4O_MINI_PROVIDER=openai
# MODEL_GPT4O_MINI_NAME=gpt-4o-mini
# MODEL_GPT4O_MINI_CAPABILITIES=text-generation,structured-generation
# MODEL_GPT4O_MINI_ENABLED=true
# MODEL_GPT4O_MINI_CONTEXT=128000
# MODEL_GPT4O_MINI_TEMPERATURE=0.1
# MODEL_GPT4O_MINI_MAX_TOKENS=4096

# MODEL_TEXT_EMBEDDING_3_SMALL_PROVIDER=openai
# MODEL_TEXT_EMBEDDING_3_SMALL_NAME=text-embedding-3-small
# MODEL_TEXT_EMBEDDING_3_SMALL_CAPABILITIES=embeddings
# MODEL_TEXT_EMBEDDING_3_SMALL_ENABLED=true
# MODEL_TEXT_EMBEDDING_3_SMALL_DIMENSIONS=1536

# MODEL_NEMOTRON_ULTRA_PROVIDER=openai
# MODEL_NEMOTRON_ULTRA_NAME=nemotron-3-ultra
# MODEL_NEMOTRON_ULTRA_CAPABILITIES=text-generation,structured-generation
# MODEL_NEMOTRON_ULTRA_ENABLED=true
# MODEL_NEMOTRON_ULTRA_CONTEXT=4096
# MODEL_NEMOTRON_ULTRA_TEMPERATURE=0.1
# MODEL_NEMOTRON_ULTRA_MAX_TOKENS=4096

# MODEL_LLAMA3_1_8B_PROVIDER=ollama
# MODEL_LLAMA3_1_8B_NAME=llama3.1:8b
# MODEL_LLAMA3_1_8B_CAPABILITIES=text-generation,structured-generation
# MODEL_LLAMA3_1_8B_ENABLED=true
# MODEL_LLAMA3_1_8B_CONTEXT=131072
# MODEL_LLAMA3_1_8B_TEMPERATURE=0.1
# MODEL_LLAMA3_1_8B_MAX_TOKENS=4096

# Default Model Assignments
# MODEL_DEFAULT_EXTRACTION=gpt-4o-mini
# MODEL_DEFAULT_CLASSIFICATION=gpt-4o-mini
# MODEL_DEFAULT_EMBEDDING=text-embedding-3-small
# MODEL_DEFAULT_REASONING=gpt-4o-mini
# MODEL_DEFAULT_MATCHING=text-embedding-3-small
# MODEL_DEFAULT_RERANKING=